<Context>
    <Box Style="BGBlock_ClearTopBar"/>

    <!-- 界面方框。固定一行4个，选项过多时向下换行 -->
    <Grid ID="MainGrid" Size="1080,410" Anchor="C,C" Style="Grid9DetailFive140" ConsumeMouse="1">
        <!-- 领袖头像按钮 -->
        <Button ID="IconButtonTop" Anchor="C,T" Offset="0,0" Size="256,128">
            <Image Anchor="C,T" AnchorSide="I,O" Offset="0,-91" Size="256,128" Texture="DecTop256x64.dds">
                <Image Anchor="C,T" Offset="0,-60" Size="128,128" Texture="Assets/UI/Art/Icons/LeaderPortraits1024Frame.dds">
                    <Image ID="MercenaryUnitLeaderPortrait" Anchor="C,C" Offset="0,0" Size="128,128" Texture="Assets/UI/Art/Icons/LeaderPortraits1024.dds"/>
                </Image>
            </Image>
        </Button>

        <!-- 左右侧边装饰 -->
        <Image Anchor="L,C" AnchorSide="O,I" Offset="-17,0" Size="32,64" Texture="Dec32x64Left.dds" />
        <Image Anchor="R,C" AnchorSide="O,I" Offset="-17,0" Size="32,64" Texture="Dec32x64Right.dds" />

        <!-- 标题 -->
        <Label ID="UCTopLabel" Anchor="C,T" Offset="0,15" Font="TwCenMT24" FontStyle="Shadow" ColorSet="Beige_Black_Alpha"/>

        <!-- 动态选择区域 -->
        <ScrollPanel ID="UCScrollPanel" Anchor="C,T" Offset="0,55" Size="1080,300" Vertical="1">
            <Stack ID="UCSelectPanel" Anchor="C,T" Offset="0,0" StackGrowth="Bottom" Padding="10"/>
            <ScrollBar Offset="12,0" Style="VertSlider" Anchor="R,C" AnchorSide="I,I" Length="250" />
            <UpButton Offset="12,7" Style="ScrollBarUp" Anchor="R,T" AnchorSide="I,I" />
            <DownButton Offset="12,7" Style="ScrollBarDown" Anchor="R,B" AnchorSide="I,I" />
        </ScrollPanel>

        <!-- 确认按钮 -->
        <GridButton ID="OKButton" Anchor="C,B" Offset="0,-30" Size="140,30" Style="BaseButton">
            <Label Anchor="C,C" Offset="0,-2" Font="TwCenMT20" FontStyle="Shadow" ColorSet="Beige_Black_Alpha"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="L,C" AnchorSide="O,O" Size="16,32" TextureOffset="0,0" Texture="buttonsidesglow.dds" Cycle="Bounce" Speed="1" AlphaStart=".99" AlphaEnd=".25"/>
                <Image Anchor="L,C" AnchorSide="O,O" Size="8,16" TextureOffset="0,0" Texture="buttonsides.dds" />
                <AlphaAnim Anchor="R,C" AnchorSide="O,O" Size="16,32" TextureOffset="16,0" Texture="buttonsidesglow.dds" Cycle="Bounce" Speed="1" AlphaStart=".99" AlphaEnd=".25"/>
                <Image Anchor="R,C" AnchorSide="O,O" Size="8,16" TextureOffset="8,0" Texture="buttonsides.dds" />
            </ShowOnMouseOver>
        </GridButton>

        <!-- 添加按钮 -->
        <GridButton ID="AddButton" Anchor="C,B" Offset="0,-90" Size="140,30" Style="BaseButton" Hidden="1" String="TXT_KEY_OPTIONAL_UC_HELP_FROM_GREAT_QINGYING" ToolTip="TXT_KEY_OPTIONAL_UC_HELP_FROM_GREAT_QINGYING_TOOLTIP">
            <Label Anchor="C,C" Offset="0,-2" Font="TwCenMT20" FontStyle="Shadow" ColorSet="Beige_Black_Alpha"/>
            <ShowOnMouseOver>
                <AlphaAnim Anchor="L,C" AnchorSide="O,O" Size="16,32" TextureOffset="0,0" Texture="buttonsidesglow.dds" Cycle="Bounce" Speed="1" AlphaStart=".99" AlphaEnd=".25"/>
                <Image Anchor="L,C" AnchorSide="O,O" Size="8,16" TextureOffset="0,0" Texture="buttonsides.dds" />
                <AlphaAnim Anchor="R,C" AnchorSide="O,O" Size="16,32" TextureOffset="16,0" Texture="buttonsidesglow.dds" Cycle="Bounce" Speed="1" AlphaStart=".99" AlphaEnd=".25"/>
                <Image Anchor="R,C" AnchorSide="O,O" Size="8,16" TextureOffset="8,0" Texture="buttonsides.dds" />
            </ShowOnMouseOver>
        </GridButton>
    </Grid>

    <!-- 一行 UC -->
    <!-- 每行固定4个 -->
    <Instance Name="UCSelectRow">
        <Stack ID="Root" Anchor="C,T" StackGrowth="Right" Padding="10"/>
    </Instance>

    <!-- 单个 UC 选择项模板 -->
    <Instance Name="UCSelectInstance">
        <Container ID="Root" Size="256,300" Anchor="C,T">
            <Stack Anchor="C,T" Offset="0,0" StackGrowth="Bottom" Padding="10">
                <Button ID="IconButton" Anchor="C,C" Offset="0,-6" Size="256,256">
                    <Image ID="PortraitFrame" Anchor="C,T" Offset="0,20" Size="256,256" TextureOffset="0,0" Texture="256x256Frame.dds">
                        <Image ID="Portrait" Anchor="C,C" Offset="0,0" Size="256,256" TextureOffset="0,0"/>
                    </Image>
                </Button>
                <PullDown ID="SelectList" Anchor="C,C" Style="GenericPullDown" ScrollThreshold="170" Size="190,30" SpaceForScroll="1"/>
            </Stack>
        </Container>
    </Instance>
</Context>
